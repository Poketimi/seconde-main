# copy to .env, puis mets UNE clé

# --- gratuit, sans carte bancaire (choisis-en un) ---
# 1. OpenRouter   https://openrouter.ai/keys        (modèles suffixés :free)
# 2. Google AI    https://aistudio.google.com/apikey
# 3. Groq         https://console.groq.com/keys
AI_PROVIDER=openrouter
AI_API_KEY=

# --- surcharges optionnelles ---
# AI_MODEL=google/gemma-4-31b-it:free
# AI_BASE_URL=https://openrouter.ai/api/v1

GEOCODER_EMAIL=timael@andrie.ch
POLL_SECONDS=300
# BROWSER_HEADLESS=0    # fenêtre visible si un site re-déclenche son contrôle
