# copy to .env, puis mets UNE clé

# --- gratuit, sans carte bancaire (choisis-en un) ---
# 1. OpenRouter   https://openrouter.ai/keys        (modèles suffixés :free)
# 2. Google AI    https://aistudio.google.com/apikey
# 3. Groq         https://console.groq.com/keys
AI_PROVIDER=openrouter
AI_API_KEY=

# --- surcharges optionnelles ---
# AI_MODEL=google/gemma-4-31b-it:free
# AI_BASE_URL=https://openrouter.ai/api/v1

GEOCODER_EMAIL=timael@andrie.ch
POLL_SECONDS=300
# BROWSER_HEADLESS=0    # fenêtre visible si un site re-déclenche son contrôle

# Traductions automatiques (français + anglais) des annonces, par cycle.
# 5 annonces par appel, donc 60 = ~12 appels. 0 pour ne rien traduire.
AI_TRANSLATE_BUDGET=60

# Tout ce qui suit se règle aussi depuis /reglages, sans redémarrer :
# AI_PROVIDER=anthropic|openai|openrouter|gemini|groq|deepseek|ollama
# AI_MODEL=<modèle bon marché, tri des annonces>
# SMART_MODEL=<bon modèle, entretien de l'assistant>
